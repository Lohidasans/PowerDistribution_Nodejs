        {
          "name": "Attendance Preview (pre-fill form)",
          "id": "547b423c-86b5-486e-a54b-e07bee7a299c",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/payrolls/attendance-preview?employee_id=3&pay_month=2026-02",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "payrolls",
                "attendance-preview"
              ],
              "query": [
                {
                  "key": "employee_id",
                  "value": "3"
                },
                {
                  "key": "pay_month",
                  "value": "2026-02"
                }
              ]
            },
            "description": "Returns worked_days, absent_days, total_days from employee_tracking. Call this when user selects employee + pay_month to pre-fill the form."
          },
          "response": []
        },
        {
          "name": "Create Payroll",
          "id": "361f9185-088e-47a8-bc01-42035f98e66a",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pay_date\": \"2026-02-25\",\n  \"branch_id\": 1,\n  \"employee_id\": 3,\n  \"pay_month\": \"2026-02\",\n  \"pf_number\": \"PF001\",\n  \"comp_off_days\": 4,\n  \"loss_of_pay_days\": 1,\n  \"earnings\": [\n    { \"payroll_master_id\": 1, \"amount\": 20000 },\n    { \"payroll_master_id\": 2, \"amount\": 1000 }\n  ],\n  \"deductions\": [\n    { \"payroll_master_id\": 4, \"amount\": 100 }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/payrolls",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "payrolls"
              ]
            },
            "description": "worked_days and absent_days are auto-calculated from employee_tracking. net_salary = total_earnings - total_deductions."
          },
          "response": []
        },
