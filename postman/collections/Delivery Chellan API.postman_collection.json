              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"delivery_challan_no\": \"DC-0001\",\n    \"date\": \"2026-01-26\",\n    \"delivery_challan_type_id\": 1, //1.Job work 2.others\n    \"vendor_id\": 10,\n    \"ref_no\": \"REF-123\",\n    \"amount_in_words\": \"One thousand only\",\n    \"sub_total\": 1000.00,\n    \"sgst\": 0.00,\n    \"cgst\": 0.00,\n    \"igst\": 0.00,\n    \"discount\": 0.00,\n    \"total_amount\": 1000.00,\n    \"remarks\": \"Test delivery chellan\",\n    \"discount_type_id\": 1, // 1.Percentage 2.Amount\n    \"status_id\": 1, //1.issued 2.closed\n    \"items\": [\n        {\n            \"sku_id\": \"SKU-001\",\n            \"product_description\": \"Product A\",\n            \"quantity\": 2,\n            \"weight\": 1.250,\n            \"amount\": 500.00\n        },\n        {\n            \"sku_id\": \"SKU-002\",\n            \"product_description\": \"Product B\",\n            \"quantity\": 1,\n            \"weight\": 0.750,\n            \"amount\": 500.00\n        }\n    ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/delivery-chellan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "delivery-chellan"
              ]
            }
          },
          "response": []
