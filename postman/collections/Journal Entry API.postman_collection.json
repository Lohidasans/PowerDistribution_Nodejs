              "raw": "{\n  \"journal_no\": \"JRN001\",\n  \"date\": \"2026-01-31\",\n  \"total\": 10000,\n  \"difference\": 0,\n  \"branch_id\": 1,\n  \"items\": [\n    {\n      \"account_id\": 2,\n      \"description\": \"Cash received from customer\",\n      \"debit\": 10000,\n      \"credit\": 0\n    },\n    {\n      \"account_id\": 1,\n      \"description\": \"Sales revenue\",\n      \"debit\": 0,\n      \"credit\": 10000\n    }\n  ]\n}"
