          "id": "2587ce1a-7019-4dc1-9c9b-e13c82952226",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"journal_no\": \"JRN001\",\n  \"date\": \"2026-01-31\",\n  \"total\": 10000,\n  \"difference\": 0,\n  \"branch_id\": 1,\n  \"items\": [\n    {\n      \"account_id\": 101,\n      \"description\": \"Cash received from customer\",\n      \"debit\": 10000,\n      \"credit\": 0\n    },\n    {\n      \"account_id\": 201,\n      \"description\": \"Sales revenue\",\n      \"debit\": 0,\n      \"credit\": 10000\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/journal-entries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "journal-entries"
              ]
            },
            "description": "Create a new journal entry with multiple items. Items array is required with at least one item."
          },
          "response": []
        },
