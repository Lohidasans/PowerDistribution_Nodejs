{
  "info": {
    "name": "Multi-Vendor Quotation System",
    "description": "Complete API collection for multi-vendor quotation management system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Super Admin - Quotations",
      "item": [
        {
          "name": "1. Generate Quotation Code",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/quotation-requests/code?prefix=QR",
              "host": ["{{baseUrl}}"],
              "path": ["quotation-requests", "code"],
              "query": [
                {
                  "key": "prefix",
                  "value": "QR"
                }
              ]
            }
          }
        },
        {
          "name": "2. Create Quotation Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qr_id\": \"QR-001\",\n  \"request_date\": \"2025-01-31\",\n  \"expiry_date\": \"2025-02-15\",\n  \"vendor_ids\": [1, 2, 3],\n  \"remarks\": \"Urgent requirement for gold items\",\n  \"items\": [\n    {\n      \"material_type_id\": 1,\n      \"category_id\": 2,\n      \"subcategory_id\": 3,\n      \"product_description\": \"Gold Ring - 22K\",\n      \"purity\": 91.6,\n      \"weight\": 10.5,\n      \"quantity\": 50\n    },\n    {\n      \"material_type_id\": 1,\n      \"category_id\": 3,\n      \"subcategory_id\": 4,\n      \"product_description\": \"Gold Necklace - Designer\",\n      \"purity\": 91.6,\n      \"weight\": 30.8,\n      \"quantity\": 20\n    }\n  ],\n  \"created_by\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/quotation-requests",
              "host": ["{{baseUrl}}"],
              "path": ["quotation-requests"]
            }
          }
        },
        {
          "name": "3. Get All Quotations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/quotation-requests?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["quotation-requests"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "search",
                  "value": "QR-001",
                  "disabled": true
                },
                {
                  "key": "vendor_id",
                  "value": "1",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "4. Get Quotation by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/quotation-requests/{{quotation_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["quotation-requests", "{{quotation_id}}"]
            }
          }
        },
        {
          "name": "5. Update Quotation Request",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expiry_date\": \"2025-02-20\",\n  \"remarks\": \"Extended deadline\",\n  \"vendor_ids\": [1, 2, 3, 4],\n  \"items\": [\n    {\n      \"id\": 1,\n      \"material_type_id\": 1,\n      \"category_id\": 2,\n      \"subcategory_id\": 3,\n      \"product_description\": \"Gold Ring - 22K Updated\",\n      \"purity\": 91.6,\n      \"weight\": 12.0,\n      \"quantity\": 60\n    }\n  ],\n  \"updated_by\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/quotation-requests/{{quotation_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["quotation-requests", "{{quotation_id}}"]
            }
          }
        },
        {
          "name": "6. Delete Quotation Request",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/quotation-requests/{{quotation_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["quotation-requests", "{{quotation_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Vendor - Quotations",
      "item": [
        {
          "name": "7. Get Vendor Quotation by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/vendor-quotations/{{vendor_quotation_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["vendor-quotations", "{{vendor_quotation_id}}"]
            }
          }
        },
        {
          "name": "8. Accept Quotation",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"accepted\",\n  \"remarks\": \"We can fulfill this order within the timeline\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vendor-quotations/{{vendor_quotation_id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["vendor-quotations", "{{vendor_quotation_id}}", "status"]
            }
          }
        },
        {
          "name": "8. Reject Quotation",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"rejected\",\n  \"remarks\": \"Cannot meet the delivery timeline\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vendor-quotations/{{vendor_quotation_id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["vendor-quotations", "{{vendor_quotation_id}}", "status"]
            }
          }
        },
        {
          "name": "9. Submit Vendor Rates",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"base_item_id\": 1,\n      \"rate\": 6500.00,\n      \"amount\": 325000.00,\n      \"vendor_remarks\": \"Premium quality 22K gold, hallmarked\"\n    },\n    {\n      \"base_item_id\": 2,\n      \"rate\": 6800.00,\n      \"amount\": 136000.00,\n      \"vendor_remarks\": \"Designer piece with intricate work\"\n    }\n  ],\n  \"remarks\": \"All items are BIS hallmarked. Delivery within 7 days. Payment terms: 50% advance, 50% on delivery.\",\n  \"sub_total\": 461000.00,\n  \"sgst_percentage\": 1.5,\n  \"sgst_amount\": 6915.00,\n  \"cgst_percentage\": 1.5,\n  \"cgst_amount\": 6915.00,\n  \"discount_percentage\": 2.0,\n  \"discount_amount\": 9220.00,\n  \"total_amount\": 465610.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vendor-quotations/{{vendor_quotation_id}}/rates",
              "host": ["{{baseUrl}}"],
              "path": ["vendor-quotations", "{{vendor_quotation_id}}", "rates"]
            }
          }
        }
      ]
    },
    {
      "name": "Testing Flow - Complete Sequence",
      "item": [
        {
          "name": "Step 1 - Create Quotation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qr_id\": \"QR-TEST-001\",\n  \"request_date\": \"2025-01-31\",\n  \"expiry_date\": \"2025-02-15\",\n  \"vendor_ids\": [1, 2, 3],\n  \"items\": [\n    {\n      \"material_type_id\": 1,\n      \"category_id\": 1,\n      \"subcategory_id\": 1,\n      \"product_description\": \"Test Item\",\n      \"quantity\": 10,\n      \"weight\": 5.0\n    }\n  ],\n  \"created_by\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/quotation-requests",
              "host": ["{{baseUrl}}"],
              "path": ["quotation-requests"]
            }
          }
        },
        {
          "name": "Step 2 - Vendor 1 Views Quotation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/vendor-quotations/1",
              "host": ["{{baseUrl}}"],
              "path": ["vendor-quotations", "1"]
            }
          }
        },
        {
          "name": "Step 3 - Vendor 1 Submits Rates",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"base_item_id\": 1,\n      \"rate\": 100.00,\n      \"amount\": 1000.00\n    }\n  ],\n  \"sub_total\": 1000.00,\n  \"sgst_percentage\": 1.5,\n  \"sgst_amount\": 15.00,\n  \"cgst_percentage\": 1.5,\n  \"cgst_amount\": 15.00,\n  \"total_amount\": 1030.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vendor-quotations/1/rates",
              "host": ["{{baseUrl}}"],
              "path": ["vendor-quotations", "1", "rates"]
            }
          }
        },
        {
          "name": "Step 4 - Vendor 2 Submits Rates",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"base_item_id\": 1,\n      \"rate\": 95.00,\n      \"amount\": 950.00\n    }\n  ],\n  \"sub_total\": 950.00,\n  \"sgst_percentage\": 1.5,\n  \"sgst_amount\": 14.25,\n  \"cgst_percentage\": 1.5,\n  \"cgst_amount\": 14.25,\n  \"total_amount\": 978.50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vendor-quotations/2/rates",
              "host": ["{{baseUrl}}"],
              "path": ["vendor-quotations", "2", "rates"]
            }
          }
        },
        {
          "name": "Step 5 - Vendor 3 Rejects",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"rejected\",\n  \"remarks\": \"Cannot meet delivery timeline\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vendor-quotations/3/status",
              "host": ["{{baseUrl}}"],
              "path": ["vendor-quotations", "3", "status"]
            }
          }
        },
        {
          "name": "Step 6 - View Final Quotation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/quotation-requests/1",
              "host": ["{{baseUrl}}"],
              "path": ["quotation-requests", "1"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "quotation_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "vendor_quotation_id",
      "value": "1",
      "type": "string"
    }
  ]
}
