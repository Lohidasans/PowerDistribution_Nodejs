{
  "info": {
    "name": "Asset Management API",
    "description": "Complete API collection for Asset Management and Maintenance History",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Asset Management",
      "item": [
        {
          "name": "1. Generate Asset Number",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/asset-management/generate-number",
              "host": ["{{baseUrl}}"],
              "path": ["asset-management", "generate-number"]
            },
            "description": "Auto-generate the next asset number in format AST0001, AST0002, etc."
          },
          "response": []
        },
        {
          "name": "2. Create Asset Management",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asset_no\": \"AST0001\",\n  \"journal_entry_id\": 1,\n  \"ledger_account_id\": 101,\n  \"asset_name\": \"Desktop Computer\",\n  \"purchase_date\": \"2026-01-15\",\n  \"asset_value\": 50000,\n  \"serial_no\": \"DC12345ABC\",\n  \"vendor_id\": 1,\n  \"upload_invoice_url\": \"https://example.com/invoice.pdf\",\n  \"status_id\": 1,\n  \"maintenance_cycle_id\": 1,\n  \"next_maintenance_date\": \"2026-07-15\",\n  \"warranty_expiry_date\": \"2028-01-15\",\n  \"upload_document_url\": \"https://example.com/warranty.pdf\",\n  \"branch_id\": 1,\n  \"department_id\": 2,\n  \"receipt_id\": null,\n  \"upload_disposal_document_url\": null,\n  \"disposal_reason\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/asset-management",
              "host": ["{{baseUrl}}"],
              "path": ["asset-management"]
            },
            "description": "Create a new asset management record."
          },
          "response": []
        },
        {
          "name": "3. Get All Assets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/asset-management?search=AST&branch_id=1",
              "host": ["{{baseUrl}}"],
              "path": ["asset-management"],
              "query": [
                {
                  "key": "search",
                  "value": "AST",
                  "description": "Search by asset_no, asset_name, or serial_no"
                },
                {
                  "key": "branch_id",
                  "value": "1",
                  "description": "Filter by branch"
                },
                {
                  "key": "vendor_id",
                  "value": "1",
                  "disabled": true,
                  "description": "Filter by vendor"
                },
                {
                  "key": "status_id",
                  "value": "1",
                  "disabled": true,
                  "description": "Filter by status"
                },
                {
                  "key": "department_id",
                  "value": "2",
                  "disabled": true,
                  "description": "Filter by department"
                },
                {
                  "key": "date_from",
                  "value": "2026-01-01",
                  "disabled": true,
                  "description": "Filter from purchase date"
                },
                {
                  "key": "date_to",
                  "value": "2026-01-31",
                  "disabled": true,
                  "description": "Filter to purchase date"
                }
              ]
            },
            "description": "Get all assets with filters."
          },
          "response": []
        },
        {
          "name": "4. Get Asset by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/asset-management/{{asset_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["asset-management", "{{asset_id}}"]
            },
            "description": "Get a specific asset with its maintenance history."
          },
          "response": []
        },
        {
          "name": "5. Update Asset",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asset_name\": \"Updated Desktop Computer\",\n  \"asset_value\": 55000,\n  \"status_id\": 2,\n  \"next_maintenance_date\": \"2026-08-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/asset-management/{{asset_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["asset-management", "{{asset_id}}"]
            },
            "description": "Update an existing asset."
          },
          "response": []
        },
        {
          "name": "6. Delete Asset",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/asset-management/{{asset_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["asset-management", "{{asset_id}}"]
            },
            "description": "Soft delete an asset."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Maintenance History",
      "item": [
        {
          "name": "1. Create Maintenance History",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-01-25\",\n  \"asset_management_id\": 1,\n  \"maintenance_type_id\": 1,\n  \"technician_name\": \"John Doe\",\n  \"machine_performance_id\": 1,\n  \"remarks\": \"Regular maintenance completed. All systems working properly.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/maintenance-history",
              "host": ["{{baseUrl}}"],
              "path": ["maintenance-history"]
            },
            "description": "Create a new maintenance history record."
          },
          "response": []
        },
        {
          "name": "2. Get All Maintenance History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/maintenance-history?asset_management_id=1",
              "host": ["{{baseUrl}}"],
              "path": ["maintenance-history"],
              "query": [
                {
                  "key": "asset_management_id",
                  "value": "1",
                  "description": "Filter by asset"
                },
                {
                  "key": "maintenance_type_id",
                  "value": "1",
                  "disabled": true,
                  "description": "Filter by maintenance type"
                },
                {
                  "key": "search",
                  "value": "John",
                  "disabled": true,
                  "description": "Search by asset_no, asset_name, or technician_name"
                },
                {
                  "key": "date_from",
                  "value": "2026-01-01",
                  "disabled": true,
                  "description": "Filter from date"
                },
                {
                  "key": "date_to",
                  "value": "2026-01-31",
                  "disabled": true,
                  "description": "Filter to date"
                }
              ]
            },
            "description": "Get all maintenance history with filters."
          },
          "response": []
        },
        {
          "name": "3. Get Maintenance History by Asset ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/maintenance-history/asset/{{asset_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["maintenance-history", "asset", "{{asset_id}}"]
            },
            "description": "Get all maintenance history for a specific asset."
          },
          "response": []
        },
        {
          "name": "4. Get Maintenance History by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/maintenance-history/{{history_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["maintenance-history", "{{history_id}}"]
            },
            "description": "Get a specific maintenance history record."
          },
          "response": []
        },
        {
          "name": "5. Update Maintenance History",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"technician_name\": \"Jane Smith\",\n  \"remarks\": \"Maintenance updated. Additional parts replaced.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/maintenance-history/{{history_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["maintenance-history", "{{history_id}}"]
            },
            "description": "Update an existing maintenance history record."
          },
          "response": []
        },
        {
          "name": "6. Delete Maintenance History",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/maintenance-history/{{history_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["maintenance-history", "{{history_id}}"]
            },
            "description": "Soft delete a maintenance history record."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "asset_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "history_id",
      "value": "1",
      "type": "string"
    }
  ]
}
