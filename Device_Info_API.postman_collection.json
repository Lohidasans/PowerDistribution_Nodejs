                    "raw": "{{base_url}}/api/v1/device-info?page=1&limit=10",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "device-info"
                    ],
                    "query": [
                        {
                            "key": "page",
                            "value": "1",
                            "description": "Page number (default: 1)"
                        },
                        {
                            "key": "limit",
                            "value": "10",
                            "description": "Items per page (default: 10)"
                        }
                    ]
                },
                "description": "Get all device infos with pagination"
