{
    "info": {
        "_postman_id": "device-info-api-collection",
        "name": "Device Info API",
        "description": "Complete Postman collection for Device Info management endpoints",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Create Device Info",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"device_name\": \"Main Counter Printer\",\n  \"mac_address\": \"00:1B:44:11:3A:B7\",\n  \"devices\": \"Thermal Printer\",\n  \"ip_address\": \"192.168.1.100\",\n  \"branch_id\": 1\n}"
                },
                "url": {
                    "raw": "{{base_url}}/api/v1/device-info",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "device-info"
                    ]
                },
                "description": "Create a new device info record. Required fields: device_name and branch_id"
            },
            "response": []
        },
        {
            "name": "List Device Infos (All)",
            "request": {
                "method": "GET",
                "header": [],
